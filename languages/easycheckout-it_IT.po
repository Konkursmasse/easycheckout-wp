msgstr "Pagamento confermato via EasyCheckout (riferimento: %s)."

msgid "Zahlung fehlgeschlagen"
msgstr "Pagamento non riuscito"

msgid "Zahlung via EasyCheckout fehlgeschlagen: %s"
msgstr "Pagamento via EasyCheckout non riuscito: %s"

msgid "Zahlung fehlgeschlagen."
msgstr "Pagamento non riuscito."

msgid "Rückerstattung via EasyCheckout"
msgstr "Rimborso via EasyCheckout"

msgid "Rückerstattung von %s via EasyCheckout verbucht."
msgstr "Rimborso di %s registrato via EasyCheckout."

msgid "You will be redirected to TWINT to complete your payment."
msgstr "Verrai reindirizzato a TWINT per completare il pagamento."

msgid "A Swiss QR-Bill will be generated for bank transfer."
msgstr "Verrà generata una QR-fattura svizzera per il bonifico bancario."

