msgstr "Caisse lancée via EasyCheckout – en attente du paiement."

msgid "Express-Checkout konnte nicht gestartet werden. Bitte erneut versuchen."
msgstr "Impossible de lancer le paiement express. Veuillez réessayer."

msgid "Express-Checkout"
msgstr "Paiement express"

msgid "Schnell bezahlen – Adresse und Zahlung in einem Schritt."
msgstr "Payer rapidement – adresse et paiement en une étape."

msgid "Der Warenkorb ist leer."
msgstr "Le panier est vide."

msgid "Express-Checkout gestartet – warte auf Zahlung via EasyCheckout."
msgstr "Paiement express lancé – en attente du paiement via EasyCheckout."

msgid "Accept payments with Credit Cards, TWINT, and Swiss QR-Bill via EasyCheckout."
msgstr "Acceptez les paiements par carte de crédit, TWINT et QR-facture suisse via EasyCheckout."

msgid "Enable/Disable"
msgstr "Activer/Désactiver"

